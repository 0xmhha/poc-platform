{
  "name": "@stablenet/web",
  "version": "0.1.0",
  "private": true,
  "description": "StableNet Web Application",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:deps": "turbo build --filter=@stablenet/web",
    "start": "next start",
    "lint": "biome lint app/ components/ hooks/ lib/",
    "lint:fix": "biome lint --write app/ components/ hooks/ lib/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@metamask/connect-evm": "~0.9.1",
    "@stablenet/contracts": "workspace:*",
    "@stablenet/core": "workspace:*",
    "@stablenet/plugin-defi": "workspace:*",
    "@stablenet/plugin-ecdsa": "workspace:*",
    "@stablenet/plugin-stealth": "workspace:*",
    "@stablenet/types": "workspace:*",
    "@stablenet/wallet-sdk": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "next": "^16.3.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.47.6",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
