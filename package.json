{
  "name": "stable-platform",
  "version": "0.1.0",
  "private": true,
  "description": "StableNet PoC Platform - ERC-4337 Account Abstraction with Privacy Features",
  "keywords": ["stablenet", "erc-4337", "account-abstraction", "smart-account", "stealth-address"],
  "license": "MIT",
  "author": "StableNet Team",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "test:watch": "turbo test:watch",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "generate": "pnpm -F @stablenet/contracts generate && pnpm -F @stablenet/contracts build",
    "graph:code": "node scripts/code-graph/generate.mjs",
    "dev:payments": "turbo run build --filter=@stablenet/web^... --filter=@stablenet/payment-hub && node scripts/payment-lab/dev.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@changesets/cli": "^2.30.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.2",
    "viem": "^2.47.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv": "8.18.0",
      "axios": "1.18.0",
      "baseline-browser-mapping": "2.11.0",
      "bn.js": "5.2.3",
      "brace-expansion": "5.0.9",
      "browserslist": "4.28.7",
      "decode-uri-component": "0.5.0",
      "elliptic": "6.6.1",
      "esbuild": "0.25.12",
      "follow-redirects": "1.16.0",
      "handlebars": "4.7.9",
      "js-yaml@3.14.2": "3.15.2",
      "js-yaml@4.1.1": "4.3.2",
      "minimatch": "10.2.3",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.7",
      "postcss": "8.5.23",
      "rollup": "4.59.0",
      "tar": "7.5.21",
      "undici": "7.29.0",
      "uuid@8.3.2": "11.1.1",
      "uuid@9.0.1": "11.1.1",
      "ws": "8.21.0"
    },
    "onlyBuiltDependencies": ["sharp", "unrs-resolver"]
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
